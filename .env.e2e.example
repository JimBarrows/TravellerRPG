# E2E Testing Environment Configuration
# Copy this file to .env and customize for your environment

# Application URLs
API_URL=http://localhost:8080
BASE_URL=http://localhost:5173

# Database Configuration
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/traveller_test

# Test Execution Settings
HEADLESS=true
SLOW_MO=0
TIMEOUT=60000
BROWSER=chromium

# Test Selection
TAGS=@smoke
PARALLEL=2
RETRY=2

# Reporting and Debugging
VIDEO=false
TRACE=false
SCREENSHOTS=failure
DEBUG=false

# Performance Testing
PERFORMANCE_MONITORING=false
LOAD_TEST_USERS=10
LOAD_TEST_DURATION=60

# CI/CD Settings
CI=false
GITHUB_ACTIONS=false

# Test Data Management
AUTO_CLEANUP=true
PRESERVE_ARTIFACTS=false

# Browser Configuration
# Supported browsers: chromium, firefox, webkit
# Device emulation: iPhone 12, Pixel 5, iPad Pro, Desktop Chrome, Desktop Firefox, Desktop Safari

# Mobile Testing
MOBILE_TESTING=true
MOBILE_DEVICE=iPhone 12

# Real-time Testing
WEBSOCKET_TIMEOUT=10000
REAL_TIME_SYNC_TIMEOUT=5000

# Security Testing
SECURITY_SCAN_ENABLED=false
VULNERABILITY_THRESHOLD=medium

# Load Testing Configuration
LOAD_TEST_ENABLED=false
MAX_CONCURRENT_USERS=50
RAMP_UP_TIME=30

# Notification Settings (for CI)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
EMAIL_NOTIFICATIONS=false

# Monitoring and Observability
METRICS_ENABLED=false
PROMETHEUS_URL=
GRAFANA_URL=

# Advanced Settings
CUSTOM_VIEWPORT_WIDTH=1280
CUSTOM_VIEWPORT_HEIGHT=720
USER_AGENT_OVERRIDE=
LOCALE=en-US
TIMEZONE=America/New_York

# API Testing Specific
GRAPHQL_INTROSPECTION=true
API_RATE_LIMIT_TEST=false
API_LOAD_TEST=false

# Cross-platform Testing
CROSS_PLATFORM_SYNC_TEST=true
MULTI_BROWSER_TEST=false
DEVICE_FARM_TEST=false

# Test Environment Isolation
ISOLATED_TEST_DATA=true
SHARED_TEST_DATABASE=false
TEST_DATA_SEED=random

# Accessibility Testing
A11Y_TESTING=false
SCREEN_READER_TEST=false
KEYBOARD_NAVIGATION_TEST=false

# Visual Regression Testing
VISUAL_REGRESSION=false
SCREENSHOT_COMPARISON=false
PIXEL_THRESHOLD=0.2

# Integration Testing
EXTERNAL_SERVICES_MOCK=true
EMAIL_SERVICE_MOCK=true
PAYMENT_SERVICE_MOCK=true

# Cleanup Configuration
AUTO_CLEANUP_FAILED_TESTS=true
CLEANUP_TIMEOUT=30000
PRESERVE_FAILURE_ARTIFACTS=true